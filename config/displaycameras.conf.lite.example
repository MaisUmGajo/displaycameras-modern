# Global configuration for the displaycameras service - LITE backend.
#
# For low-power boards (Raspberry Pi Zero / Zero W / Pi 1): a single fullscreen
# camera rendered straight to KMS (no X server), cycling through the camera
# list. Camera names/feeds and rotation live in layout.conf.default.
#
# Installed to /etc/displaycameras/displaycameras.conf

#### Backend

# lite = single fullscreen camera via DRM (no X). auto lets the board decide;
# it resolves to lite on ARMv6 boards. Force it here if needed.
backend=lite

#### Global options

# Network timeout, in seconds, for establishing/holding a feed (mpv).
net_timeout=30

# Hardware decoding (mpv --hwdec). IMPORTANT: on the Pi, mpv's "auto-safe" does
# NOT engage the VideoCore decoder (it only probes desktop hwdecs) and falls
# back to software. Use v4l2m2m-copy to actually offload H.264 to the hardware
# - measured ~15-20% of one core on a Pi Zero W for 640x360-1024x576, vs
# ~50-80% in software. Alternatives: no (software), drm-prime (zero-copy).
hwdec=v4l2m2m-copy

# Video output. Use 'gpu' - the service adds --gpu-context=drm so it renders and
# scales on the VideoCore GPU with no X server. (Plain 'drm' scales in software
# and stalls weak boards like the Pi Zero.) The lite backend also applies
# mpv --profile=fast automatically for real-time playback on slow GPUs.
# Tip: on a Pi Zero W, a 640x360 substream runs ~33% of the core; 1024x576 works
# but uses ~70%+. Prefer the lower-res substream for headroom.
vo=gpu

# How the feed fills the screen: letterbox (default) | stretch | crop
fill_mode=letterbox

# Startup pacing (seconds).
startsleep=3
feedsleep=1
retry=5

# The supervisor re-checks and repairs a stalled/dead feed this often (seconds).
repair_interval=5

# Self-heal watchdog: reconnect the feed if its decoder error count jumps by at
# least error_reload_threshold within watchdog_interval seconds (clears a
# persistently corrupt picture that still "plays"). Set interval 0 to disable.
watchdog_interval=15
error_reload_threshold=10

# Window repositioning is not used on the lite backend (no windows).
reposition_interval=0

# Seconds each camera is shown before rotating to the next (see rotate in the
# layout file). On a single-camera board, rotation is the whole point.
rotatedelay=8
