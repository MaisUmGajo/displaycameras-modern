#!/bin/bash
# displaycameras (modern) - RTSP camera video wall for Raspberry Pi 4 on
# Raspberry Pi OS Bookworm (the latest Raspbian).
#
# A faithful, modernized port of https://github.com/Anonymousdog/displaycameras
# The original used omxplayer + dispmanx + dbus, all of which are gone on the
# Pi 4 / Bookworm KMS graphics stack. This version controls/monitors mpv over
# its JSON IPC socket (see displaycameras-ipc) and has two render backends:
#   full - X11 + openbox + one mpv per tile (grids, optional dual-HDMI). Pi 4/5.
#   lite - a single fullscreen mpv straight to KMS (--vo=drm), no X, cycling
#          through the camera list. For low-power ARMv6 boards (Pi Zero/1).
# CLI verbs and config schema are kept compatible with the original.
#
# version: 1.3.0

set -o pipefail

# ---------------------------------------------------------------------------
# Locate the IPC helper (prefer a copy alongside this script, e.g. when run
# straight from the repo, otherwise the installed one).
# ---------------------------------------------------------------------------
SELFDIR="$(dirname "$(readlink -f "$0")")"
IPC="$SELFDIR/displaycameras-ipc"
[ -x "$IPC" ] || IPC="/usr/local/bin/displaycameras-ipc"

CONF_DIR="/etc/displaycameras"
GLOBAL_CONF="$CONF_DIR/displaycameras.conf"

# Choose a render backend from the board. Only the ARMv6 boards (Pi 1, Zero,
# Zero W) auto-select the lightweight "lite" path; everything else defaults to
# "full" and can be overridden with backend=lite in the config. (Mid boards
# such as Pi 2/3 default to full pending hardware validation.)
detect_backend() {
	if [ "$(uname -m 2>/dev/null)" = "armv6l" ]; then echo lite; else echo full; fi
}

# Early hardware report - needs no config, deps, or root (used by install and
# the test plan). Safe to run before anything is installed.
case "${1:-}" in
	detect|--detect)
		model="$(cat /proc/device-tree/model 2>/dev/null | tr -d '\000')"
		echo "model:          ${model:-unknown}"
		echo "arch:           $(uname -m 2>/dev/null)"
		echo "backend (auto): $(detect_backend)"
		exit 0
		;;
esac

# Runtime dir for IPC sockets, PID and sequence files. When run from the
# systemd service this is created for us by RuntimeDirectory=displaycameras
# (owned by the service user). /run is not writable by a normal user, so for
# manual/standalone runs fall back to a user-writable location.
RUN_DIR="/run/displaycameras"
if ! mkdir -p "$RUN_DIR" 2>/dev/null || [ ! -w "$RUN_DIR" ]; then
	RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/displaycameras"
	mkdir -p "$RUN_DIR" 2>/dev/null
fi
SEQ_FILE="$RUN_DIR/sequence"
PIDFILE="$RUN_DIR/displaycameras.pid"

# ---------------------------------------------------------------------------
# Prerequisites
# ---------------------------------------------------------------------------
if ! command -v mpv >/dev/null 2>&1; then
	echo "mpv is not installed. Run install.sh or 'apt install mpv'." >&2
	exit 1
fi
if [ ! -x "$IPC" ]; then
	echo "displaycameras-ipc helper not found or not executable ($IPC)." >&2
	exit 1
fi
if [ ! -r "$GLOBAL_CONF" ]; then
	echo "$GLOBAL_CONF does not exist or is not readable." >&2
	exit 1
fi
# shellcheck source=/dev/null
. "$GLOBAL_CONF"

if [ ! -r "$CONF_DIR/layout.conf.default" ]; then
	echo "$CONF_DIR/layout.conf.default does not exist or is not readable." >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Optional display autodetection: pick layout.conf.<WxH> based on the current
# X screen resolution (xrandr), falling back to layout.conf.default.
# (Replaces the original fbset-based detection, which no longer applies.)
# ---------------------------------------------------------------------------
displaydetectactive=false
if [ "$displaydetect" = "true" ] && command -v xrandr >/dev/null 2>&1 && [ -n "$DISPLAY" ]; then
	mode="$(xrandr --current 2>/dev/null | awk '/\*/{print $1; exit}')"
	if [ -n "$mode" ] && [ -r "$CONF_DIR/layout.conf.$mode" ]; then
		# shellcheck source=/dev/null
		. "$CONF_DIR/layout.conf.$mode"
		displaydetectactive=true
	else
		# shellcheck source=/dev/null
		. "$CONF_DIR/layout.conf.default"
		[ -n "$mode" ] && echo "No layout configuration file found for $mode; using default."
	fi
else
	# shellcheck source=/dev/null
	. "$CONF_DIR/layout.conf.default"
fi

# ---------------------------------------------------------------------------
# Defaults / normalization
# ---------------------------------------------------------------------------
# net_timeout is the modern name; accept the original omx_timeout for compat.
net_timeout="${net_timeout:-${omx_timeout:-30}}"
startsleep="${startsleep:-3}"
feedsleep="${feedsleep:-1}"
retry="${retry:-5}"
rotatedelay="${rotatedelay:-5}"
repair_interval="${repair_interval:-5}"
reposition_interval="${reposition_interval:-10}"
# Self-heal watchdog: every watchdog_interval seconds, reconnect a tile that is
# still "playing" (so normal repair ignores it) but is either (a) throwing decode
# errors - a corrupt/blurry picture - at >= error_reload_threshold per interval,
# or (b) frozen: its time-pos has stopped advancing (a silently stalled stream).
# Set watchdog_interval=0 to disable.
watchdog_interval="${watchdog_interval:-15}"
error_reload_threshold="${error_reload_threshold:-10}"
# Reconnect a "playing" tile whose playback runs below this fraction of real
# time (0.5 = half speed) - catches silently stalled/degraded streams. To avoid
# reconnecting on brief congestion dips, only act after stall_strikes consecutive
# slow checks (so ~stall_strikes x watchdog_interval of sustained slowness). Set
# stall_rate=0 to disable the stall check.
stall_rate="${stall_rate:-0.5}"
stall_strikes="${stall_strikes:-2}"
fill_mode="${fill_mode:-letterbox}"
seq_step="${seq_step:-1}"
blank="${blank:-true}"

# Render backend: auto | full | lite. 'auto' picks from the board.
backend="${backend:-auto}"
if [ "$backend" = "auto" ]; then backend="$(detect_backend)"; fi
# Video output and hardware decoder defaults depend on the backend. Note that
# mpv's "auto-safe" does NOT engage the Pi's V4L2 decoder (it only probes
# desktop hwdecs), so the lite backend defaults to v4l2m2m-copy, which offloads
# H.264 decode to the VideoCore even on a Pi Zero (measured ~15-20% of one core
# for 640x360-1024x576, vs ~50-80% in software).
if [ "$backend" = "lite" ]; then
	# gpu + gpu-context=drm (added at launch) renders/scales on the VideoCore
	# GPU; plain --vo=drm scales in software and stalls weak boards.
	vo="${vo:-gpu}"; hwdec="${hwdec:-v4l2m2m-copy}"
else
	vo="${vo:-gpu}"; hwdec="${hwdec:-auto-safe}"
fi

# Dual-HDMI (Pi 4 has two outputs). When enabled, arrange-displays lays the two
# outputs out as one X screen; layouts may assign tiles to an output via the
# optional window_outputs array (coordinates are then relative to that output).
dual_hdmi="${dual_hdmi:-false}"
hdmi0_output="${hdmi0_output:-}"
hdmi1_output="${hdmi1_output:-}"
hdmi0_mode="${hdmi0_mode:-}"
hdmi1_mode="${hdmi1_mode:-}"
hdmi1_position="${hdmi1_position:-right-of}"

cameras="${#camera_names[@]}"
# The lite backend is a single fullscreen tile; the full backend has one tile
# per window_positions entry.
if [ "$backend" = "lite" ]; then
	nwin=1
else
	nwin="${#window_positions[@]}"
fi
max_seq=$((cameras - 1))
if [ "$cameras" -lt 1 ]; then
	echo "No cameras defined (camera_names is empty)." >&2
	exit 1
fi
# The number of distinct cameras comes from camera_names. Warn on the common
# misconfiguration of defining tiles/feeds but leaving camera_names short, which
# makes tiles repeat cameras (or, with fewer feeds than names, index gaps).
if [ "$cameras" -lt "$nwin" ] && [ "$rotate" != "true" ]; then
	echo "Warning: $cameras camera_names for $nwin tiles - tiles will repeat cameras. Add names to camera_names to match." >&2
fi
if [ "${#camera_feeds[@]}" -lt "$cameras" ]; then
	echo "Warning: ${#camera_feeds[@]} camera_feeds but $cameras camera_names - missing feeds will be blank." >&2
fi
if [ "$seq_step" -gt "$max_seq" ] 2>/dev/null || [ "$seq_step" -lt 1 ] 2>/dev/null; then
	seq_step=1
fi

# Current rotation offset (persisted across invocations within a run)
if [ ! -f "$SEQ_FILE" ]; then echo 0 >"$SEQ_FILE"; fi
DISPLAY_SEQUENCE="$(cat "$SEQ_FILE" 2>/dev/null)"
[ -n "$DISPLAY_SEQUENCE" ] || DISPLAY_SEQUENCE=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# camera index currently assigned to window index $1, given the rotation offset
cam_for_window() {
	local w="$1"
	echo $(( ( (w + DISPLAY_SEQUENCE) % cameras + cameras) % cameras ))
}

sock_for_window()  { echo "$RUN_DIR/win-$1.sock"; }
pidf_for_window()  { echo "$RUN_DIR/win-$1.pid"; }

# Print the "X Y" pixel offset of an xrandr output within the combined X
# screen (e.g. "1920 0" for a second monitor placed to the right). Prints
# nothing if the output can't be found; callers treat that as "0 0".
output_offset() {
	xrandr --current 2>/dev/null | awk -v o="$1" '
		$1==o && $2=="connected" {
			for (i=3;i<=NF;i++)
				if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
					split($i,a,"+"); print a[2], a[3]; exit
				}
		}'
}

# Translate an original-style "x1 y1 x2 y2" rectangle into an mpv --geometry
# string WxH+X+Y. If an xrandr output name is given as $2, the rectangle is
# treated as relative to that output and shifted by its screen offset.
# Prints nothing on malformed input.
geometry_for() {
	local rect="$1" output="${2:-}" x1 y1 x2 y2 w h ox=0 oy=0
	read -r x1 y1 x2 y2 <<<"$rect"
	[ -n "$x2" ] && [ -n "$y2" ] || return 1
	if [ -n "$output" ]; then
		read -r ox oy < <(output_offset "$output")
		ox="${ox:-0}"; oy="${oy:-0}"
	fi
	w=$((x2 - x1 + 1))
	h=$((y2 - y1 + 1))
	echo "${w}x${h}+$((x1 + ox))+$((y1 + oy))"
}

# mpv flags derived from fill_mode
fill_flags() {
	case "$fill_mode" in
		stretch)  echo "--no-keepaspect" ;;
		crop)     echo "--keepaspect --panscan=1.0" ;;
		*)        echo "--keepaspect --panscan=0.0" ;; # letterbox (default)
	esac
}

# Launch a fresh mpv for tile index $1 showing URL $2.
launch_tile() {
	local w="$1" url="$2"
	local sock pidf geom
	sock="$(sock_for_window "$w")"
	pidf="$(pidf_for_window "$w")"
	rm -f "$sock"

	if [ "$backend" = "lite" ]; then
		# Lite: one fullscreen render to KMS - no X, no window manager. Use the
		# GPU present path (--vo=gpu --gpu-context=drm): plain --vo=drm scales in
		# software and stalls weak boards. --profile=fast keeps a Pi Zero real
		# time (negligible quality loss on a small display). hwdec offloads the
		# H.264 decode to the VideoCore.
		local gpuctx=()
		[ "$vo" = "gpu" ] && gpuctx=(--gpu-context="${gpu_context:-drm}")
		# shellcheck disable=SC2046
		mpv \
			--no-config \
			--input-ipc-server="$sock" \
			--vo="$vo" "${gpuctx[@]}" \
			--hwdec="$hwdec" \
			--profile=low-latency --profile=fast \
			--no-audio \
			--force-window=yes --idle=yes --keep-open=no \
			--no-input-terminal --no-input-default-bindings \
			--cache=no \
			--network-timeout="$net_timeout" \
			--rtsp-transport=tcp \
			--really-quiet \
			$(fill_flags) \
			-- "$url" >/dev/null 2>&1 &
		echo $! >"$pidf"
		return 0
	fi

	# Full: an X11 window placed at its tile geometry.
	geom="$(geometry_for "${window_positions[$w]}" "${window_outputs[$w]:-}")"
	if [ -z "$geom" ]; then
		echo "Window $w has an invalid position: '${window_positions[$w]}'" >&2
		return 1
	fi
	# shellcheck disable=SC2046
	mpv \
		--no-config \
		--input-ipc-server="$sock" \
		--geometry="$geom" \
		--x11-name="dctile$w" --title="dctile$w" \
		--autofit-larger=100%x100% \
		--no-border --no-osc --osd-level=0 --no-input-terminal \
		--no-input-default-bindings --input-vo-keyboard=no \
		--cursor-autohide=always \
		--no-audio \
		--force-window=immediate --idle=yes --keep-open=no \
		--profile=low-latency \
		--cache=no \
		--network-timeout="$net_timeout" \
		--rtsp-transport=tcp \
		--hwdec="$hwdec" \
		--vo="$vo" \
		--really-quiet \
		$(fill_flags) \
		-- "$url" >/dev/null 2>&1 &
	echo $! >"$pidf"
}

# Force window $1 to its exact computed geometry. A stacking WM (openbox) may
# clamp a client's requested position when it spans a second monitor, so after
# the window maps we move/resize it explicitly (which the WM honors). Requires
# xdotool and a running X server; a no-op without them.
place_window() {
	local w="$1" geom rest wd ht x y wid tries=0
	[ "$backend" = "lite" ] && return 0    # no windows to place under DRM
	command -v xdotool >/dev/null 2>&1 || return 0
	[ -n "$DISPLAY" ] || return 0
	geom="$(geometry_for "${window_positions[$w]}" "${window_outputs[$w]:-}")"
	[ -n "$geom" ] || return 0
	wd="${geom%%x*}"; rest="${geom#*x}"
	ht="${rest%%+*}"; rest="${rest#*+}"
	x="${rest%%+*}"; y="${rest##*+}"
	# Wait for the window to appear (matched by its unique x11 name).
	while [ "$tries" -lt 20 ]; do
		wid="$(xdotool search --classname "dctile$w" 2>/dev/null | head -n1)"
		[ -n "$wid" ] && break
		sleep 0.25; tries=$((tries + 1))
	done
	[ -n "$wid" ] || return 0
	# Skip if already correctly placed, so this can run often without churn.
	local X Y WIDTH HEIGHT SCREEN WINDOW
	eval "$(xdotool getwindowgeometry --shell "$wid" 2>/dev/null)"
	if [ "$X" = "$x" ] && [ "$Y" = "$y" ] && [ "$WIDTH" = "$wd" ] && [ "$HEIGHT" = "$ht" ]; then
		return 0
	fi
	xdotool windowsize "$wid" "$wd" "$ht" windowmove --sync "$wid" "$x" "$y" 2>/dev/null
}

# Is the mpv for window $1 alive and actively playing a feed?
tile_playing() {
	local sock idle tp
	sock="$(sock_for_window "$1")"
	[ -S "$sock" ] || return 1
	idle="$("$IPC" getprop "$sock" idle-active 2>/dev/null)" || return 1
	[ "$idle" = "false" ] || return 1
	tp="$("$IPC" getprop "$sock" time-pos 2>/dev/null)" || return 1
	[ -n "$tp" ] || return 1
	return 0
}

# Does the mpv process for window $1 still exist?
tile_process_alive() {
	local pidf pid
	pidf="$(pidf_for_window "$1")"
	[ -r "$pidf" ] || return 1
	pid="$(cat "$pidf" 2>/dev/null)"
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Verbs
# ---------------------------------------------------------------------------
case "$1" in

start)
	if [ -f "$PIDFILE" ]; then
		echo "PID file exists. Stop or restart the service instead."
		exit 1
	fi
	if [ "$displaydetectactive" = "true" ]; then
		echo "Display detection active for $mode."
	fi
	for w in $(seq 0 $((nwin - 1))); do
		ci="$(cam_for_window "$w")"
		name="${camera_names[$ci]}"
		url="${camera_feeds[$ci]}"
		echo "Starting tile $w -> ${name}"
		launch_tile "$w" "$url"
		sleep "$startsleep"
		tries=0
		until tile_playing "$w"; do
			sleep 1
			tries=$((tries + 1))
			echo "Waiting for ${name} ($tries/$retry)"
			[ "$tries" -ge "$retry" ] && break
		done
		if tile_playing "$w"; then
			echo "${name} playing"
		else
			echo "${name} not yet playing (will be retried by repair)"
		fi
		sleep "$feedsleep"
	done
	touch "$PIDFILE"
	# Now that the tiles have settled, force each to its exact geometry. A
	# stacking WM can clamp windows that span a second monitor; this fixes it.
	for w in $(seq 0 $((nwin - 1))); do
		place_window "$w"
	done
	echo "Camera display started. Run 'displaycameras status' for details."
	;;

stop)
	rm -f "$PIDFILE"
	echo 0 >"$SEQ_FILE"
	for w in $(seq 0 $((nwin - 1))); do
		sock="$(sock_for_window "$w")"
		[ -S "$sock" ] && "$IPC" quit "$sock" 2>/dev/null
	done
	sleep 1
	for w in $(seq 0 $((nwin - 1))); do
		pidf="$(pidf_for_window "$w")"
		if [ -r "$pidf" ]; then
			pid="$(cat "$pidf" 2>/dev/null)"
			[ -n "$pid" ] && kill "$pid" 2>/dev/null
			rm -f "$pidf"
		fi
		rm -f "$(sock_for_window "$w")"
	done
	echo "Camera display stopped."
	exit 0
	;;

restart)
	"$0" stop
	sleep 1
	"$0" start
	;;

# Reconnect/relaunch any tile that is not actively playing.
repair)
	[ -f "$PIDFILE" ] || exit 0
	relaunched=false
	for w in $(seq 0 $((nwin - 1))); do
		if tile_playing "$w"; then
			continue
		fi
		ci="$(cam_for_window "$w")"
		url="${camera_feeds[$ci]}"
		if tile_process_alive "$w"; then
			# mpv is up but idle/stalled: just reload the feed in place.
			"$IPC" loadfile "$(sock_for_window "$w")" "$url" 2>/dev/null
		else
			# mpv died: bring the tile back. Repositioning happens after it
			# settles (below, and via the supervise loop).
			echo "Relaunching tile $w -> ${camera_names[$ci]}"
			launch_tile "$w" "$url"
			relaunched=true
		fi
	done
	# Reposition after any relaunch (give the new window a moment to settle).
	if [ "$relaunched" = "true" ]; then
		sleep "$startsleep"
		for w in $(seq 0 $((nwin - 1))); do
			place_window "$w"
		done
	fi
	;;

# Advance the rotation one step and reassign feeds to the fixed tiles.
rotate)
	[ -f "$PIDFILE" ] || exit 0
	DISPLAY_SEQUENCE=$(( ( (DISPLAY_SEQUENCE - seq_step) % cameras + cameras) % cameras ))
	for w in $(seq 0 $((nwin - 1))); do
		ci="$(cam_for_window "$w")"
		"$IPC" loadfile "$(sock_for_window "$w")" "${camera_feeds[$ci]}" 2>/dev/null
	done
	echo "$DISPLAY_SEQUENCE" >"$SEQ_FILE"
	;;

# Rotate in the opposite direction.
rotaterev)
	[ -f "$PIDFILE" ] || exit 0
	DISPLAY_SEQUENCE=$(( ( (DISPLAY_SEQUENCE + seq_step) % cameras + cameras) % cameras ))
	for w in $(seq 0 $((nwin - 1))); do
		ci="$(cam_for_window "$w")"
		"$IPC" loadfile "$(sock_for_window "$w")" "${camera_feeds[$ci]}" 2>/dev/null
	done
	echo "$DISPLAY_SEQUENCE" >"$SEQ_FILE"
	;;

status)
	for w in $(seq 0 $((nwin - 1))); do
		ci="$(cam_for_window "$w")"
		name="${camera_names[$ci]}"
		if tile_playing "$w"; then
			echo "tile $w ${name}: playing"
		else
			echo "tile $w ${name}: NOT playing"
		fi
	done
	;;

positions)
	for w in $(seq 0 $((nwin - 1))); do
		ci="$(cam_for_window "$w")"
		name="${camera_names[$ci]}"
		tp="$("$IPC" getprop "$(sock_for_window "$w")" time-pos 2>/dev/null)"
		echo "tile $w ${name}: ${tp:-n/a}s"
	done
	;;

# Foreground supervisor: keeps the session alive and periodically repairs
# tiles and (optionally) rotates feeds. Started by the session/runner.
# Uses real elapsed time (not a loop counter): on slow boards each iteration
# can take several seconds (spawning repair/watchdog helpers), so tick counting
# would make the intervals - especially rotation - far longer than configured.
supervise)
	trap 'exit 0' TERM INT
	now="$(date +%s)"
	last_repair="$now"; last_reposition="$now"; last_watchdog="$now"; last_rotate="$now"
	while true; do
		sleep 1
		now="$(date +%s)"
		if [ "$repair_interval" -gt 0 ] && [ $((now - last_repair)) -ge "$repair_interval" ]; then
			"$0" repair; last_repair="$(date +%s)"
		fi
		if [ "$backend" = "full" ] && [ "$reposition_interval" -gt 0 ] && [ $((now - last_reposition)) -ge "$reposition_interval" ]; then
			"$0" reposition; last_reposition="$(date +%s)"
		fi
		if [ "$watchdog_interval" -gt 0 ] && [ $((now - last_watchdog)) -ge "$watchdog_interval" ]; then
			"$0" watchdog; last_watchdog="$(date +%s)"
		fi
		if [ "$rotate" = "true" ] && [ "$rotatedelay" -gt 0 ] && [ $((now - last_rotate)) -ge "$rotatedelay" ]; then
			if [ "$seq_step" -gt 1 ]; then
				"$0" rotaterev
			else
				"$0" rotate
			fi
			last_rotate="$(date +%s)"
		fi
	done
	;;

# Reconnect any tile whose decoder is throwing errors (a corrupt/glitched
# stream keeps "playing" - frames still advance - so repair never touches it,
# and the corruption can persist for a long time until a clean keyframe is
# forced by reconnecting). We reconnect when the decoder error count jumps by
# at least error_reload_threshold since the last check.
watchdog)
	[ -f "$PIDFILE" ] || exit 0
	now="$(date +%s)"
	for w in $(seq 0 $((nwin - 1))); do
		sock="$(sock_for_window "$w")"
		[ -S "$sock" ] || continue
		# Only manage tiles that claim to be playing; idle/dead ones are repair's job.
		[ "$("$IPC" getprop "$sock" idle-active 2>/dev/null)" = "false" ] || continue
		ci="$(cam_for_window "$w")"
		reason=""

		# (1) Decode-error burst -> stream corruption (e.g. "half the image
		# blurry"). Reconnect if errors rose by >= error_reload_threshold.
		if [ "$error_reload_threshold" -gt 0 ] 2>/dev/null; then
			cur="$("$IPC" getprop "$sock" decoder-frame-drop-count 2>/dev/null)"
			f="$RUN_DIR/win-$w.derr"; prev="$(cat "$f" 2>/dev/null)"; [ -n "$prev" ] || prev=0
			if [ -n "$cur" ]; then
				if [ "$cur" -lt "$prev" ] 2>/dev/null; then echo "$cur" >"$f"
				elif [ "$cur" -ge "$((prev + error_reload_threshold))" ] 2>/dev/null; then reason="decode errors +$((cur - prev))"
				else echo "$cur" >"$f"; fi
			fi
		fi

		# (2) Stalled/slow stream: still "playing" but its time-pos advances far
		# below real-time - a silently degraded or fully frozen RTSP/TCP
		# connection ("frozen in time"). repair can't see it; a reconnect grabs a
		# fresh connection, which pulls at full rate again. We compare playback
		# advance to wall-clock elapsed since the last check and reconnect when it
		# is running below stall_rate (default 0.5 = half real-time). A time-pos
		# decrease (reload/rotation) just re-baselines.
		if [ -z "$reason" ] && [ "${stall_rate:-0}" != "0" ]; then
			tp="$("$IPC" getprop "$sock" time-pos 2>/dev/null)"
			tf="$RUN_DIR/win-$w.tpos"
			set -- $(cat "$tf" 2>/dev/null); ptp="${1:-}"; pwc="${2:-}"; pst="${3:-0}"
			if [ -n "$tp" ]; then
				st=0
				if [ -n "$ptp" ] && [ -n "$pwc" ]; then
					# s: 1 = slow this check, -1 = time-pos reset (reload/rotation), 0 = ok
					s="$(awk -v tp="$tp" -v ptp="$ptp" -v now="$now" -v pwc="$pwc" -v r="$stall_rate" 'BEGIN{
						wd=now-pwc; td=tp-ptp;
						if (td<0) print -1; else if (wd>=5 && td/wd<r) print 1; else print 0}')"
					if [ "$s" = "1" ]; then
						st=$((pst + 1))
						[ "$st" -ge "${stall_strikes:-2}" ] && reason="stalled (< ${stall_rate}x real-time, ${st} checks)"
					fi
				fi
				[ -z "$reason" ] && echo "$tp $now $st" >"$tf"
			fi
		fi

		if [ -n "$reason" ]; then
			echo "Watchdog: tile $w (${camera_names[$ci]}) $reason; reconnecting"
			"$IPC" loadfile "$sock" "${camera_feeds[$ci]}" 2>/dev/null
			echo 0 >"$RUN_DIR/win-$w.derr"; rm -f "$RUN_DIR/win-$w.tpos"
		fi
	done
	;;

# Re-apply every tile's exact geometry (fixes any WM placement drift).
reposition)
	[ -f "$PIDFILE" ] || exit 0
	for w in $(seq 0 $((nwin - 1))); do
		place_window "$w"
	done
	;;

# Arrange the two Pi 4 HDMI outputs into one X screen (used for dual-HDMI
# walls). Called by displaycameras-session before the tiles start. A no-op
# unless dual_hdmi="true". Needs a running X server (DISPLAY set).
arrange-displays)
	[ "$backend" = "lite" ] && exit 0
	[ "$dual_hdmi" = "true" ] || exit 0
	if ! command -v xrandr >/dev/null 2>&1; then
		echo "xrandr not found; cannot arrange displays." >&2
		exit 1
	fi
	# Auto-detect connected outputs if not configured.
	if [ -z "$hdmi0_output" ] || [ -z "$hdmi1_output" ]; then
		mapfile -t _connected < <(xrandr --query 2>/dev/null | awk '/ connected/{print $1}')
		[ -z "$hdmi0_output" ] && hdmi0_output="${_connected[0]:-}"
		[ -z "$hdmi1_output" ] && hdmi1_output="${_connected[1]:-}"
	fi
	if [ -z "$hdmi0_output" ] || [ -z "$hdmi1_output" ]; then
		echo "Could not determine two connected outputs for dual-HDMI." >&2
		echo "Set hdmi0_output/hdmi1_output in displaycameras.conf." >&2
		exit 1
	fi
	# Primary output at the origin.
	if [ -n "$hdmi0_mode" ]; then
		xrandr --output "$hdmi0_output" --mode "$hdmi0_mode" --pos 0x0 --primary
	else
		xrandr --output "$hdmi0_output" --auto --pos 0x0 --primary
	fi
	# Second output positioned relative to the first.
	case "$hdmi1_position" in
		left-of|right-of|above|below) _rel="--$hdmi1_position" ;;
		*) _rel="--right-of" ;;
	esac
	if [ -n "$hdmi1_mode" ]; then
		xrandr --output "$hdmi1_output" --mode "$hdmi1_mode" "$_rel" "$hdmi0_output"
	else
		xrandr --output "$hdmi1_output" --auto "$_rel" "$hdmi0_output"
	fi
	echo "Arranged $hdmi0_output (primary) and $hdmi1_output ($hdmi1_position)."
	;;

*)
	echo "Usage: displaycameras {start|stop|restart|repair|status|positions|rotate|rotaterev|reposition|watchdog|arrange-displays|supervise|detect}"
	exit 1
	;;
esac
