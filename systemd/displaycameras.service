[Unit]
Description=displaycameras RTSP camera video wall
Documentation=https://github.com/Anonymousdog/displaycameras
After=network-online.target systemd-user-sessions.target
Wants=network-online.target
# Take over tty1 from the login getty so X can own the console.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
# The installer rewrites this User= line to the account you choose.
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UnsetEnvironment=TERM
# Launch a bare X server whose only client is the camera-wall session.
ExecStart=/usr/bin/xinit /usr/local/bin/displaycameras-session -- :0 vt1 -keeptty -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
